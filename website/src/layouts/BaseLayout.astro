---
import "../styles/global.css";
import type { SiteContent } from "../data/content";

interface Props { content: SiteContent }
const { content } = Astro.props;
const isPt = content.locale === "pt";
const title = isPt
  ? "RDP Session Manager — administração RDP para Linux"
  : "RDP Session Manager — RDP administration for Linux";
const description = content.hero.body;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(isPt ? `${base}/` : `${base}/en/`, Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "RDP Session Manager",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Linux",
  description,
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  downloadUrl: "https://github.com/Pedroltz/RDP-SessionManager/releases/latest",
  codeRepository: "https://github.com/Pedroltz/RDP-SessionManager"
};
---

<!doctype html>
<html lang={content.locale === "pt" ? "pt-BR" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101014" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {import.meta.env.PUBLIC_DEPLOYMENT_SHA && <meta name="deployment-revision" content={import.meta.env.PUBLIC_DEPLOYMENT_SHA} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(`${base}/`, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`${base}/en/`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(`${base}/`, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}/og.png`, Astro.site)} />
    <meta property="og:locale" content={isPt ? "pt_BR" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(`${base}/og.png`, Astro.site)} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
