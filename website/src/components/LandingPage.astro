---
import type { SiteContent } from "../data/content";
import BrandMark from "./BrandMark.astro";
import ProductPreview from "./ProductPreview.astro";

interface Props { content: SiteContent }
const { content: c } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = c.locale === "pt" ? `${base}/` : `${base}/en/`;
const languageHref = c.locale === "pt" ? `${base}/en/` : `${base}/`;
const repo = "https://github.com/Pedroltz/RDP-SessionManager";
const installCommand = `curl -fsSL ${repo}/releases/latest/download/install.sh | bash`;
const featurePaths = [
  "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M16 3a4 4 0 0 1 0 8 M22 21v-2a4 4 0 0 0-3-3.87 M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0",
  "M3 4h18v13H3z M8 21h8 M12 17v4 M3 8h18",
  "M3 3h8v8H3z M14 3h7v8h-7z M3 14h8v7H3z M14 14h7v7h-7z",
  "m4 6 6 6-6 6 M13 18h7",
  "M22 12h-4l-3 9L9 3l-3 9H2",
  "M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11 M9 12l2 2 4-4"
];
---

<a class="skip-link" href="#main">{c.locale === "pt" ? "Pular para o conteúdo" : "Skip to content"}</a>
<header class="site-header shell">
  <a class="brand" href={home} aria-label="RDP Session Manager">
    <BrandMark />
    <span class="brand-wordmark"><strong>RDP</strong><span>Session Manager</span></span>
  </a>
  <nav aria-label={c.locale === "pt" ? "Navegação principal" : "Primary navigation"}>
    <a href="#features">{c.nav.features}</a>
    <a href="#compatibility">{c.nav.compatibility}</a>
    <a href="#install">{c.nav.install}</a>
  </nav>
  <div class="header-actions">
    <a class="language-link" aria-label={c.langName} href={languageHref} hreflang={c.locale === "pt" ? "en" : "pt-BR"} lang={c.locale === "pt" ? "en" : "pt-BR"}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18 M12 3a18 18 0 0 1 0 18 18 18 0 0 1 0-18"/></svg>
      <span class="language-full">{c.langName}</span><span class="language-short" aria-hidden="true">{c.locale === "pt" ? "EN" : "PT"}</span>
    </a>
    <a class="header-github" href={repo} aria-label={c.hero.github}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.15c-3.09.67-3.74-1.31-3.74-1.31-.51-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.6 1.2 3.23.92.1-.72.39-1.2.71-1.48-2.47-.28-5.06-1.24-5.06-5.49 0-1.21.43-2.2 1.14-2.97-.12-.28-.5-1.41.11-2.94 0 0 .93-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.66.11 2.94.71.77 1.14 1.76 1.14 2.97 0 4.26-2.6 5.2-5.08 5.48.4.35.75 1.02.75 2.06v3.12c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
    </a>
  </div>
</header>

<main id="main">
  <section class="hero shell" aria-labelledby="hero-title">
    <p class="eyebrow"><span class="accent-dot" aria-hidden="true"></span>{c.hero.kicker}</p>
    <h1 id="hero-title">{c.hero.title}<br/><span>{c.hero.accent}</span></h1>
    <p class="hero-body">{c.hero.body}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#install">{c.hero.install}<span aria-hidden="true">↓</span></a>
      <a class="button button-secondary" href={repo}>{c.hero.github}<span aria-hidden="true">↗</span></a>
    </div>
    <ul class="tech-list" aria-label={c.locale === "pt" ? "Tecnologias" : "Technologies"}>
      <li>GTK 4</li><li>libadwaita</li><li>xrdp</li><li>umu / Proton</li>
    </ul>
    <ProductPreview content={c} />
  </section>

  <section id="features" class="section shell" aria-labelledby="features-title">
    <div class="section-heading"><p class="eyebrow">{c.features.kicker}</p><h2 id="features-title">{c.features.title}</h2><p>{c.features.body}</p></div>
    <div class="feature-grid">
      {c.features.items.map((feature, index) => <article class="feature">
        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={featurePaths[index]}/></svg>
        <h3>{feature.title}</h3><p>{feature.body}</p>
      </article>)}
    </div>
  </section>

  <section id="compatibility" class="section shell compatibility" aria-labelledby="compatibility-title">
    <div class="section-heading"><p class="eyebrow">{c.compatibility.kicker}</p><h2 id="compatibility-title">{c.compatibility.title}</h2><p>{c.compatibility.body}</p></div>
    <div class="compatibility-grid">{c.compatibility.groups.map((group) => <div><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></div>)}</div>
  </section>

  <section id="install" class="section shell" aria-labelledby="install-title">
    <div class="install-panel">
      <div class="section-heading"><p class="eyebrow">{c.install.kicker}</p><h2 id="install-title">{c.install.title}</h2><p>{c.install.body}</p></div>
      <div class="command-box">
        <div class="command-heading"><span>Terminal</span><button type="button" data-copy data-copied={c.install.copied} data-failed={c.install.copyFailed} hidden>{c.install.copy}</button></div>
        <pre tabindex="0" aria-label={c.locale === "pt" ? "Comando de instalação" : "Installation command"}><code id="install-command">{installCommand}</code></pre>
      </div>
      <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
      <div class="install-links"><a class="text-link" href={`${repo}/blob/master/docs/INSTALL.md`}>{c.install.docs}<span aria-hidden="true"> ↗</span></a><a class="text-link" href={`${repo}/releases/latest`}>{c.install.releases}<span aria-hidden="true"> ↗</span></a></div>
      <p class="requirements"><strong>{c.install.requirements}</strong> {c.install.reqBody}</p>
    </div>
  </section>

  <section class="section shell faq" aria-labelledby="faq-title">
    <div class="section-heading"><p class="eyebrow">{c.faq.kicker}</p><h2 id="faq-title">{c.faq.title}</h2></div>
    <div class="faq-list">{c.faq.items.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
  </section>
</main>

<footer class="site-footer shell">
  <div><a class="brand" href={home}><BrandMark />RDP Session Manager</a><p>{c.footer}</p></div>
  <div class="footer-links"><a href={repo}>GitHub ↗</a><a href={`${repo}/blob/master/docs/INSTALL.md`}>{c.install.docs}</a><a href={`${repo}/blob/master/LICENSE`}>GPL-3.0</a></div>
</footer>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy]");
  const command = document.querySelector<HTMLElement>("#install-command");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  if (button && command && status) {
    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(command.textContent ?? "");
        status.textContent = button.dataset.copied ?? "";
      } catch {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(command);
        selection?.removeAllRanges();
        selection?.addRange(range);
        status.textContent = button.dataset.failed ?? "";
      }
    });
  }
</script>
